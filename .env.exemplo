# Exemplo de .env

# Instruções
# Copie esse arquivo para .env e altere os valores relevantes

# Use True para desenvolvimento e False para produção
DEBUG=True

# Chave secreta do Django, gere uma nova para produção
SECRET_KEY=troque-esta-chave-por-uma-aleatoria

# Configurações de email para recuperação de senha
# (em desenvolvimento, se EMAIL_HOST ficar vazio os e-mails aparecem no terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Valores separados por espaço
ALLOWED_HOSTS="127.0.0.1 localhost"

# Chaves OAuth2 do SUAP. Gerar em https://suap.ifrn.edu.br/admin/api/aplicacaooauth2/
SUAP_CLIENT_ID=
SUAP_CLIENT_SECRET=

# Configurações do DB em produção (MySQL)
DB_NAME=<nome do BD>
DB_HOST=<ip do BD>
DB_PORT=<porta do BD>
DB_USER=<usuario do BD>
DB_PASSWORD=<senha do BD>

# Somente produção (DEBUG=False): caminhos de arquivos estáticos/uploads e hosts
# STATIC_ROOT=/caminho/para/staticfiles
# MEDIA_ROOT=/caminho/para/media
# CSRF_TRUSTED_ORIGINS="https://seudominio.com.br"
